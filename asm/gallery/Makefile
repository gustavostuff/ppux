# ca65 gallery ROM (CNROM oversize, up to 16 slides)
#
# Layout:
#   s/         assembly sources
#   o/         object files (generated)
#   gallery.nes (generated, this directory)
#   data/chr/  8KB CHR banks (generated by PPUX)
#   data/nam/  1024B nametables (generated by PPUX)
#   data/pal/slideNN/main.pal  32B palettes (generated by PPUX)
#
# Requires cc65 (ca65/ld65) on PATH.

AS = ca65
LD = ld65
CFG = nes.cfg
SRC = s
OBJ = o

CHR_BINS = \
	data/chr/slide00.chr data/chr/slide01.chr data/chr/slide02.chr data/chr/slide03.chr \
	data/chr/slide04.chr data/chr/slide05.chr data/chr/slide06.chr data/chr/slide07.chr \
	data/chr/slide08.chr data/chr/slide09.chr data/chr/slide10.chr data/chr/slide11.chr \
	data/chr/slide12.chr data/chr/slide13.chr data/chr/slide14.chr data/chr/slide15.chr

NAM_BINS = \
	data/nam/slide00.nam data/nam/slide01.nam data/nam/slide02.nam data/nam/slide03.nam \
	data/nam/slide04.nam data/nam/slide05.nam data/nam/slide06.nam data/nam/slide07.nam \
	data/nam/slide08.nam data/nam/slide09.nam data/nam/slide10.nam data/nam/slide11.nam \
	data/nam/slide12.nam data/nam/slide13.nam data/nam/slide14.nam data/nam/slide15.nam

PAL_BINS = \
	data/pal/slide00/main.pal data/pal/slide01/main.pal data/pal/slide02/main.pal data/pal/slide03/main.pal \
	data/pal/slide04/main.pal data/pal/slide05/main.pal data/pal/slide06/main.pal data/pal/slide07/main.pal \
	data/pal/slide08/main.pal data/pal/slide09/main.pal data/pal/slide10/main.pal data/pal/slide11/main.pal \
	data/pal/slide12/main.pal data/pal/slide13/main.pal data/pal/slide14/main.pal data/pal/slide15/main.pal

SRCS = \
	header \
	vars \
	cnrom \
	controller \
	palette \
	gallery \
	nmi \
	reset \
	main \
	nam_slots \
	chr_slots \
	slide_meta \
	vectors

OBJS = $(addprefix $(OBJ)/,$(addsuffix .o,$(SRCS)))

.PHONY: all clean dirs ensure-data distclean

all: dirs ensure-data gallery.nes

dirs:
	mkdir -p $(OBJ) data/chr data/nam \
		data/pal/slide00 data/pal/slide01 data/pal/slide02 data/pal/slide03 \
		data/pal/slide04 data/pal/slide05 data/pal/slide06 data/pal/slide07 \
		data/pal/slide08 data/pal/slide09 data/pal/slide10 data/pal/slide11 \
		data/pal/slide12 data/pal/slide13 data/pal/slide14 data/pal/slide15

# Zero-fill missing slide bins so a bare `make` still links.
# Default palette: BG 07 17 27 36 x4, SPR 07 0F 0F 0F x4.
ensure-data: dirs
	@for i in 00 01 02 03 04 05 06 07 08 09 10 11 12 13 14 15; do \
		if [ ! -f data/chr/slide$$i.chr ]; then dd if=/dev/zero of=data/chr/slide$$i.chr bs=8192 count=1 status=none; fi; \
		if [ ! -f data/nam/slide$$i.nam ]; then dd if=/dev/zero of=data/nam/slide$$i.nam bs=1024 count=1 status=none; fi; \
		if [ ! -f data/pal/slide$$i/main.pal ]; then \
			printf '\x07\x17\x27\x36\x07\x17\x27\x36\x07\x17\x27\x36\x07\x17\x27\x36\x07\x0f\x0f\x0f\x07\x0f\x0f\x0f\x07\x0f\x0f\x0f\x07\x0f\x0f\x0f' \
				> data/pal/slide$$i/main.pal; \
		fi; \
	done

gallery.nes: $(OBJS)
	$(LD) -C $(CFG) -o $@ $(OBJS)

$(OBJ)/chr_slots.o: $(SRC)/chr_slots.s $(CHR_BINS) | dirs
	$(AS) -o $@ $<

$(OBJ)/nam_slots.o: $(SRC)/nam_slots.s $(NAM_BINS) | dirs
	$(AS) -o $@ $<

$(OBJ)/palette.o: $(SRC)/palette.s $(PAL_BINS) | dirs ensure-data
	$(AS) -o $@ $<

$(OBJ)/%.o: $(SRC)/%.s | dirs
	$(AS) -o $@ $<

clean:
	rm -rf $(OBJ)
	rm -f gallery.nes

distclean: clean
	rm -f data/chr/*.chr data/nam/*.nam
	rm -f data/pal/slide*/main.pal
